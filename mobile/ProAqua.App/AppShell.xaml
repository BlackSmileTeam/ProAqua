<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProAqua.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ProAqua.App.Pages"
    Title="ПроАква"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource MidnightBlue}"
    Shell.BackgroundColor="{StaticResource MidnightBlue}"
    Shell.ForegroundColor="{StaticResource Primary}"
    Shell.TitleColor="{StaticResource White}"
    Shell.DisabledColor="{StaticResource Gray500}"
    Shell.UnselectedColor="{StaticResource Gray400}"
    Shell.TabBarBackgroundColor="{StaticResource OffBlack}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Gray400}"
    Shell.TabBarTitleColor="{StaticResource Primary}">

    <TabBar>
        <ShellContent Title="Главная"
                      Icon="tab_home.png"
                      ContentTemplate="{DataTemplate pages:HomePage}"
                      Route="home" />
        <ShellContent Title="Акции"
                      Icon="tab_promotions.png"
                      ContentTemplate="{DataTemplate pages:PromotionsPage}"
                      Route="promotions" />
        <ShellContent Title="Записи"
                      Icon="tab_history.png"
                      ContentTemplate="{DataTemplate pages:HistoryPage}"
                      Route="history" />
        <ShellContent Title="Профиль"
                      Icon="tab_profile.png"
                      ContentTemplate="{DataTemplate pages:ProfilePage}"
                      Route="profile" />
    </TabBar>

</Shell>
