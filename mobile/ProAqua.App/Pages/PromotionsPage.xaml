<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.PromotionsPage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Акции"
             Shell.NavBarIsVisible="False">

    <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,28" Spacing="14">
                <Label Text="Акции"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label x:Name="EmptyLabel"
                       Text="Сейчас активных акций нет"
                       FontSize="14"
                       TextColor="{StaticResource Gray400}"
                       IsVisible="False" />

                <CollectionView x:Name="PromotionsList" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource CardStrokeBrush}"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#140A2F3F"
                                    Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16,16,0,0"
                                            HeightRequest="150"
                                            IsVisible="{Binding HasImage}">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="150" />
                                    </Border>
                                    <VerticalStackLayout Padding="14" Spacing="6">
                                        <Label Text="{Binding Title}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray300}"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding PeriodText}"
                                               FontSize="12"
                                               TextColor="{StaticResource Primary}"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
