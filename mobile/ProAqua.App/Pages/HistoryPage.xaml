<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.HistoryPage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Записи"
             Shell.NavBarIsVisible="False">
    <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
        <ScrollView>
            <VerticalStackLayout Padding="0,8,0,20" Spacing="14">
                <Label Text="Мои записи"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="20,8,20,0" />

                <VerticalStackLayout x:Name="UpcomingSection" IsVisible="False" Spacing="10" Margin="16,0">
                    <Label Text="Предстоящие"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <CollectionView x:Name="UpcomingList"
                                      SelectionMode="None"
                                      ItemsLayout="VerticalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16"
                                        Margin="0,0,0,10"
                                        StrokeThickness="1.5"
                                        Stroke="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 18"
                                        BackgroundColor="#1A0F2A36">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding ServiceTitle}"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   FontSize="16" />
                                            <Border Grid.Column="1"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#3326C6DA"
                                                    Padding="8,4">
                                                <Label Text="{Binding StatusRu}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding DateTimeText, StringFormat='Ждём вас: {0}'}"
                                               TextColor="White"
                                               FontSize="14"
                                               FontAttributes="Bold" />
                                        <Label Text="Эта запись ещё впереди"
                                               TextColor="{StaticResource Gray300}"
                                               FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PastSection" Spacing="10" Margin="16,0">
                    <Label x:Name="PastHeader"
                           Text="Прошедшие"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray300}" />
                    <CollectionView x:Name="PastList"
                                    SelectionMode="None"
                                    ItemsLayout="VerticalList">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32">
                                <Label Text="Пока нет записей"
                                       TextColor="White"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Нажмите «Записаться» на главной — визит появится здесь"
                                       TextColor="{StaticResource Gray300}"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16"
                                        Margin="0,0,0,10"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        BackgroundColor="{StaticResource Gray900}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding ServiceTitle}"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   FontSize="16" />
                                            <Border Grid.Column="1"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#3326C6DA"
                                                    Padding="8,4">
                                                <Label Text="{Binding StatusRu}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <Label Grid.Row="1"
                                               Text="{Binding DateTimeText}"
                                               TextColor="{StaticResource Gray300}"
                                               FontSize="13" />
                                        <Button Grid.Row="2"
                                                Text="Повторить запись"
                                                Clicked="OnRepeat"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource Primary}"
                                                BorderColor="{StaticResource Gray600}"
                                                BorderWidth="1"
                                                CornerRadius="12"
                                                HeightRequest="40" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
