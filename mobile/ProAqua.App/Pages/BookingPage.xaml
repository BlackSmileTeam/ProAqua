<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.BookingPage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Запись"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="16,12,16,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#140A0A0A"
                    WidthRequest="40"
                    HeightRequest="40">
                <Label Text="←"
                       FontSize="22"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   Text="Запись"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="24,16,24,24" Spacing="16">
            <Label x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" TextColor="White" />
            <Label Text="Выберите дату" TextColor="{StaticResource Gray300}" FontSize="14" />

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource Gray900}" Padding="4,0">
                <DatePicker x:Name="DatePicker"
                            TextColor="White"
                            Format="dd-MM-yyyy"
                            DateSelected="OnDateChanged" />
            </Border>

            <Label x:Name="SelectedDateLabel"
                   TextColor="{StaticResource Primary}"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Label Text="Свободное время" TextColor="{StaticResource Gray300}" FontSize="14" />

            <Label x:Name="NoSlotsLabel"
                   IsVisible="False"
                   Text="На эту дату нет свободных слотов. Выберите другой день."
                   TextColor="{StaticResource Gray300}"
                   FontSize="13" />

            <CollectionView x:Name="SlotsList"
                            SelectionMode="None"
                            HeightRequest="220">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1.5"
                                Stroke="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource Gray900}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSlotTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding TimeText}"
                                   HorizontalTextAlignment="Center"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="15" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="SelectedSlotLabel"
                   TextColor="{StaticResource Secondary}"
                   FontSize="13"
                   IsVisible="False" />

            <Button x:Name="ConfirmButton"
                    Text="Подтвердить запись"
                    Clicked="OnConfirm"
                    IsEnabled="False"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    CornerRadius="14"
                    HeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
