<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.ChangePasswordPage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Новый пароль"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="28" Spacing="16" VerticalOptions="Center">
        <Label Text="Новый пароль" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />

        <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource Gray900}" Padding="16,2">
            <Entry x:Name="CurrentEntry" Placeholder="Текущий пароль" IsPassword="True" TextColor="White" PlaceholderColor="{StaticResource Gray400}" BackgroundColor="Transparent" HeightRequest="48" />
        </Border>
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource Gray900}" Padding="16,2">
            <Entry x:Name="NewEntry" Placeholder="Новый пароль" IsPassword="True" TextColor="White" PlaceholderColor="{StaticResource Gray400}" BackgroundColor="Transparent" HeightRequest="48" />
        </Border>
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource Gray900}" Padding="16,2">
            <Entry x:Name="ConfirmEntry" Placeholder="Повтор пароля" IsPassword="True" TextColor="White" PlaceholderColor="{StaticResource Gray400}" BackgroundColor="Transparent" HeightRequest="48" />
        </Border>

        <Button Text="Сохранить" Clicked="OnSaveClicked" BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource PrimaryDarkText}" CornerRadius="22" HeightRequest="52" />
        <Button x:Name="CancelButton" Text="Отмена" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="{StaticResource Gray300}" IsVisible="False" />
        <Label x:Name="ErrorLabel" TextColor="#FB7185" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
