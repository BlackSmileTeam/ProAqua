<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.ServiceDetailPage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Услуга"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="16,12,16,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#140A2F3F"
                    WidthRequest="40"
                    HeightRequest="40">
                <Label Text="←"
                       FontSize="22"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   Text="Услуга"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="16,12,16,28" Spacing="14">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="180">
                        <Image x:Name="HeroImage" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="TitleLabel"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Border x:Name="PurposeBadge"
                                Grid.Column="1"
                                IsVisible="False"
                                StrokeThickness="1"
                                Stroke="{StaticResource CardStrokeBrush}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="#1A0F2A36"
                                Padding="8,3"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShowPurpose" />
                            </Border.GestureRecognizers>
                            <Label Text="?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>
                    <Label x:Name="DescriptionLabel"
                           FontSize="14"
                           TextColor="{StaticResource Gray300}"
                           LineBreakMode="WordWrap" />

                    <Border x:Name="DetailsCard"
                            IsVisible="False"
                            StrokeThickness="1"
                            Stroke="{StaticResource CardStrokeBrush}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#140A2F3F"
                            Padding="10,8">
                        <WebView x:Name="DetailsWeb"
                                 HeightRequest="620" />
                    </Border>

                    <Label Text="Тип автомобиля"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0,8,0,0" />
                    <VerticalStackLayout x:Name="VehicleTypesHost" Spacing="0" />

                    <Label Text="Выберите услугу"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0,8,0,0" />
                    <VerticalStackLayout x:Name="VariantsHost" Spacing="10" />

                    <Label x:Name="SelectedPriceLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           IsVisible="False" />

                    <Button x:Name="BookButton"
                            Text="Выбрать время"
                            IsVisible="False"
                            IsEnabled="False"
                            Clicked="OnBook"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="50" />
                </VerticalStackLayout>
            </ScrollView>

            <Grid x:Name="LoadingOverlay"
                  IsVisible="False"
                  BackgroundColor="#CC001018"
                  InputTransparent="False">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" WidthRequest="44" HeightRequest="44" />
                    <Label Text="Загрузка услуги…" TextColor="White" FontSize="14" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
