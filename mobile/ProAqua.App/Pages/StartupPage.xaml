<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.StartupPage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="24">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
            <Image Source="logo.png" WidthRequest="120" HeightRequest="112" Aspect="AspectFit" />
            <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
            <Label Text="Проверяем сессию..."
                   TextColor="{StaticResource Gray300}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
