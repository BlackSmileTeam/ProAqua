<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.HomePage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Главная"
             Shell.NavBarIsVisible="False">

    <RefreshView x:Name="Refresh" Refreshing="OnRefresh">
        <ScrollView x:Name="MainScroll">
            <VerticalStackLayout Padding="0,0,0,28" Spacing="18">

                <Grid Padding="20,16,20,0">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Image Source="brand_app.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                        <Label Text="ПроАква"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <Border x:Name="UpcomingBookingCard"
                        IsVisible="False"
                        StrokeThickness="1.5"
                        Stroke="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="#1A0A0A0A"
                        Margin="16,0"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenBookings" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ваша ближайшая запись"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray300}" />
                            <Label x:Name="UpcomingServiceLabel"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label x:Name="UpcomingWhenLabel"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold" />
                            <Label x:Name="UpcomingStatusLabel"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray300}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="›"
                               FontSize="28"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <ScrollView x:Name="PromoScroll"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                HeightRequest="312"
                                Margin="16,0"
                                Scrolled="OnPromoScrolled">
                        <HorizontalStackLayout x:Name="PromoRow" Spacing="12" Padding="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="{Binding SlideWidth}"
                                            HeightRequest="312"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource MidnightBlue}"
                                            Padding="0">
                                        <Grid IsClippedToBounds="True">
                                            <!-- Full-bleed promo image -->
                                            <Image Source="{Binding ImageSource}"
                                                   Aspect="AspectFill"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />

                                            <!-- Soft blur-like fade: transparent → black so page bg shows through -->
                                            <Border StrokeThickness="0"
                                                    InputTransparent="True"
                                                    VerticalOptions="Fill"
                                                    HorizontalOptions="Fill">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0.0" />
                                                        <GradientStop Color="#00000000" Offset="0.38" />
                                                        <GradientStop Color="#66000000" Offset="0.58" />
                                                        <GradientStop Color="#CC000000" Offset="0.78" />
                                                        <GradientStop Color="#000000" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Title + subtitle overlaid on image (bottom) -->
                                            <VerticalStackLayout VerticalOptions="End"
                                                                 Padding="16,0,16,18"
                                                                 Spacing="4"
                                                                 InputTransparent="True">
                                                <Label Text="{Binding Title}"
                                                       FontSize="17"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="2" />
                                                <Label Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Primary}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPromoCardTapped" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <HorizontalStackLayout x:Name="PromoDashIndicators"
                                           HorizontalOptions="Center"
                                           Spacing="6" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" Padding="0,4,0,0">
                    <Grid Margin="20,0,20,0" ColumnDefinitions="*,Auto">
                        <Label Text="Наши услуги"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Ещё"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenServicesCatalog" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never"
                                HeightRequest="248"
                                Margin="20,0,8,0">
                        <HorizontalStackLayout x:Name="ServicesRow" Spacing="12" Padding="0,0,12,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="168"
                                            HeightRequest="236"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource CardStrokeBrush}"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource Gray900}"
                                            Padding="0">
                                        <Grid>
                                            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsService}">
                                                <Image Source="{Binding ImageSource}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="168"
                                                       HeightRequest="148"
                                                       HorizontalOptions="Fill" />
                                                <VerticalStackLayout Padding="12,10,12,12" Spacing="4"
                                                                     BackgroundColor="{StaticResource Gray900}">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           LineBreakMode="WordWrap"
                                                           MaxLines="2"
                                                           HeightRequest="36" />
                                                    <Label Text="{Binding PriceText}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout IsVisible="{Binding IsMore}"
                                                                 VerticalOptions="Center"
                                                                 HorizontalOptions="Center"
                                                                 Spacing="8">
                                                <Label Text="Ещё"
                                                       FontSize="22"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="Все услуги"
                                                       FontSize="13"
                                                       TextColor="{StaticResource Gray300}"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPreviewCardTapped" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <Button Text="Записаться"
                        Clicked="OnBookCta"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="17"
                        CornerRadius="16"
                        HeightRequest="54"
                        Margin="20,4,20,0"
                        ContentLayout="Left, 10"
                        ImageSource="icon_calendar.png" />

                <Border StrokeThickness="1"
                        Stroke="{StaticResource CardStrokeBrush}"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#140A0A0A"
                        Margin="20,0"
                        Padding="14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoyaltyBanner" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="icon_loyalty.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Программа лояльности"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   FontSize="14" />
                            <Label Text="Мойте чаще — платите меньше"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
