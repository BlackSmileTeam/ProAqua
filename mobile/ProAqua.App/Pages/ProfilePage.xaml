<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProAqua.App.Pages.ProfilePage"
             BackgroundColor="{StaticResource MidnightBlue}"
             Title="Профиль"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

            <Label Text="Профиль"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />

            <Grid ColumnDefinitions="96,*" ColumnSpacing="14">
                <Border x:Name="AvatarBorder"
                        StrokeThickness="1"
                        Stroke="{StaticResource CardStrokeBrush}"
                        StrokeShape="RoundRectangle 48"
                        WidthRequest="96"
                        HeightRequest="96"
                        BackgroundColor="{StaticResource Gray900}"
                        Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAvatarTapped" />
                        <PointerGestureRecognizer PointerEntered="OnAvatarPointerEntered"
                                                  PointerExited="OnAvatarPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image x:Name="AvatarImage" Source="login_icon.png" Aspect="AspectFill" />
                        <Border x:Name="AvatarEditHint"
                                IsVisible="False"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0,0,48,48"
                                BackgroundColor="#99000000"
                                VerticalOptions="End"
                                HeightRequest="26">
                            <Label Text="изменить"
                                   FontSize="10"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                    <Label x:Name="NameLabel" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="PhoneLabel" FontSize="14" TextColor="{StaticResource Gray300}" />
                </VerticalStackLayout>
            </Grid>

            <Border StrokeThickness="1"
                    Stroke="{StaticResource CardStrokeBrush}"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="#000000"
                    Padding="0"
                    HeightRequest="188">
                <Grid>
                    <!-- Full-bleed background image so content (including level strip) sits on top of the picture -->
                    <Image Source="loyalty_jeep.png"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />

                    <!-- Fade the image smoothly into the app background -->
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#F2000000" Offset="0" />
                                <GradientStop Color="#CC000000" Offset="0.52" />
                                <GradientStop Color="#66000000" Offset="0.78" />
                                <GradientStop Color="#33000000" Offset="1" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <VerticalStackLayout Padding="14,12,10,16" Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image x:Name="LevelIcon"
                                   Source="icon_level_guest.png"
                                   WidthRequest="56"
                                   HeightRequest="68"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Уровень лояльности"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray300}" />
                                <Label x:Name="LevelLabel"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                <Grid x:Name="LevelProgressTrack"
                                      HeightRequest="7"
                                      SizeChanged="OnLevelProgressTrackSizeChanged">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            BackgroundColor="{StaticResource Gray600}" />
                                    <Border x:Name="LevelProgressFill"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            BackgroundColor="{StaticResource Primary}"
                                            HorizontalOptions="Start"
                                            WidthRequest="40" />
                                </Grid>
                                <Label x:Name="NextLevelLabel"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray300}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#336B5A28" HorizontalOptions="Fill" />

                        <VerticalStackLayout Spacing="2" Margin="0,0,0,4">
                            <Label Text="Ваши бонусы"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray300}" />
                            <Label x:Name="PointsLabel"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{StaticResource CardStrokeBrush}"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="#140A0A0A"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="icon_referral.png"
                               WidthRequest="36"
                               HeightRequest="36"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Реферальная программа"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Пригласите друга — бонусы вам и ему"
                                   TextColor="{StaticResource Gray300}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Border StrokeThickness="1"
                            Stroke="{StaticResource CardStrokeBrush}"
                            StrokeDashArray="6,4"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="Transparent"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Ваш реферальный код"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray400}" />
                                <Label x:Name="ReferralCodeLabel"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1"
                                         Source="icon_copy.png"
                                         WidthRequest="34"
                                         HeightRequest="34"
                                         BackgroundColor="Transparent"
                                         Clicked="OnCopyReferral"
                                         VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{StaticResource CardStrokeBrush}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource Gray900}"
                    Padding="14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChangePasswordTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Image Source="icon_lock.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Сменить пароль"
                           TextColor="White"
                           FontSize="15"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="24"
                           TextColor="{StaticResource Gray400}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{StaticResource CardStrokeBrush}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="Transparent"
                    HeightRequest="50"
                    Padding="14,0"
                    Margin="0,8,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogout" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="icon_logout.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <Label Text="Выйти из аккаунта"
                           TextColor="{StaticResource Primary}"
                           FontSize="16"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
