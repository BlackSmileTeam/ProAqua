FRONTEND_PORT=55512
BACKEND_PORT=55511
# Optional compose mysql (--profile local-mysql). Unused when API uses external/host MySQL.
# If you start local-mysql, avoid conflicting with host MySQL on 3306.
MYSQL_PORT=3307

MYSQL_ROOT_PASSWORD='RootMysql_ChangeMe_2026!'
MYSQL_DATABASE=proaqua
MYSQL_APP_USER=proaqua
MYSQL_APP_PASSWORD='ProAquaApp_ChangeMe_2026!'

# Used literally by the API (ConnectionStrings__DefaultConnection). Deploy copies
# GitHub secret DB_CONNECTION_STRING here as-is — Server is NOT rewritten to mysql.
# Keep Database=/User=/Password= as in your real MySQL (e.g. aquapro or proaqua).
# Quote values that contain ! or $ so compose --env-file does not truncate them.
APP_CONNECTION_STRING='Server=139.100.225.234;Port=3306;Database=proaqua;User=proaqua;Password=ProAquaApp_ChangeMe_2026!;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True'

JWT_KEY='ProAquaJwt_ChangeMe_AtLeast_32_Chars_Prod!'
JWT_ISSUER=ProAquaApi
JWT_AUDIENCE=ProAquaClient

PUSH_PROVIDER=Dev

AMOCRM_ENABLED=false
AMOCRM_BASE_URL=https://YOUR.amocrm.ru
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=

VITE_API_URL=

# Swagger UI on backend (and via admin nginx /swagger). Set false to disable in Production.
ENABLE_SWAGGER=true
