FRONTEND_PORT=55512
BACKEND_PORT=55511
# MySQL уже на хосте (как bebochka) — отдельный mysql-контейнер не обязателен.
# Если в compose всё же есть mysql — не конфликтуйте с портом 3306 хоста.
MYSQL_PORT=3307

MYSQL_ROOT_PASSWORD=RootMysql_ChangeMe_2026!
MYSQL_DATABASE=proaqua
MYSQL_APP_USER=proaqua
MYSQL_APP_PASSWORD=ProAquaApp_ChangeMe_2026!

# API на том же сервере (Docker) → MySQL на хосте:
# APP_CONNECTION_STRING=server=host.docker.internal;port=3306;database=proaqua;user=proaqua;password=ProAquaApp_ChangeMe_2026!;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True

# Локальная разработка / как в bebochka — прямой IP сервера:
APP_CONNECTION_STRING=Server=139.100.225.234;Port=3306;Database=proaqua;User=proaqua;Password=ProAquaApp_ChangeMe_2026!;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True

JWT_KEY=ProAquaJwt_ChangeMe_AtLeast_32_Chars_Prod!
JWT_ISSUER=ProAquaApi
JWT_AUDIENCE=ProAquaClient

PUSH_PROVIDER=Dev

AMOCRM_ENABLED=false
AMOCRM_BASE_URL=https://YOUR.amocrm.ru
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=

VITE_API_URL=

# Swagger UI on backend (and via admin nginx /swagger). Set false to disable in Production.
ENABLE_SWAGGER=true
